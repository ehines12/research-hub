{
  "id": "macro",
  "title": "Macro Dashboard",
  "subtitle": "US growth, labor, inflation, rates and real-time alternative data. Sources: FRED (St. Louis Fed), Atlanta Fed (GDPNow), Cleveland Fed (inflation nowcast) and Treasury Fiscal Data (DTS).",
  "series": [
    {
      "key": "gdp",
      "fred": "A191RL1Q225SBEA",
      "title": "Real GDP growth",
      "units": "% q/q SAAR",
      "transform": "level",
      "fmt": "pct1",
      "chg": "pp",
      "freq": "Quarterly"
    },
    {
      "key": "gdpnow",
      "fred": "GDPNOW",
      "source": "gdpnow",
      "title": "Atlanta Fed GDPNow",
      "units": "% q/q SAAR",
      "transform": "level",
      "fmt": "pct1",
      "chg": "pp",
      "freq": "Daily",
      "no_yoy": true,
      "link": "https://www.atlantafed.org/cqer/research/gdpnow",
      "src_label": "Atlanta Fed GDPNow (daily nowcast)"
    },
    {
      "key": "gdpnow_q",
      "fred": "GDPNOW",
      "title": "GDPNow, latest nowcast by quarter",
      "units": "% q/q SAAR",
      "transform": "level",
      "fmt": "pct1",
      "chg": "pp",
      "freq": "Quarterly",
      "kpi": false
    },
    {
      "key": "unrate",
      "fred": "UNRATE",
      "title": "Unemployment rate",
      "units": "%",
      "transform": "level",
      "fmt": "pct1",
      "chg": "pp",
      "freq": "Monthly",
      "invert": true
    },
    {
      "key": "payrolls",
      "fred": "PAYEMS",
      "title": "Nonfarm payrolls, m/m",
      "units": "thous.",
      "transform": "diff",
      "fmt": "k0",
      "chg": "k",
      "freq": "Monthly"
    },
    {
      "key": "claims",
      "fred": "ICSA",
      "title": "Initial jobless claims",
      "units": "thous.",
      "transform": "div1000",
      "fmt": "k0",
      "chg": "k",
      "freq": "Weekly",
      "invert": true
    },
    {
      "key": "cpi",
      "fred": "CPIAUCSL",
      "title": "CPI, y/y",
      "units": "%",
      "transform": "yoy",
      "fmt": "pct1",
      "chg": "pp",
      "freq": "Monthly",
      "invert": true
    },
    {
      "key": "corepce",
      "fred": "PCEPILFE",
      "title": "Core PCE, y/y",
      "units": "%",
      "transform": "yoy",
      "fmt": "pct1",
      "chg": "pp",
      "freq": "Monthly",
      "invert": true
    },
    {
      "key": "dff",
      "fred": "DFF",
      "title": "Effective fed funds",
      "units": "%",
      "transform": "level",
      "fmt": "pct2",
      "chg": "bp",
      "freq": "Daily"
    },
    {
      "key": "dgs2",
      "fred": "DGS2",
      "title": "2Y Treasury",
      "units": "%",
      "transform": "level",
      "fmt": "pct2",
      "chg": "bp",
      "freq": "Daily"
    },
    {
      "key": "dgs10",
      "fred": "DGS10",
      "title": "10Y Treasury",
      "units": "%",
      "transform": "level",
      "fmt": "pct2",
      "chg": "bp",
      "freq": "Daily"
    },
    {
      "key": "spread",
      "fred": "T10Y2Y",
      "title": "10Y - 2Y spread",
      "units": "pp",
      "transform": "level",
      "fmt": "pp2",
      "chg": "bp",
      "freq": "Daily"
    },
    {
      "key": "indpro",
      "fred": "INDPRO",
      "title": "Industrial production, y/y",
      "units": "%",
      "transform": "yoy",
      "fmt": "pct1",
      "chg": "pp",
      "freq": "Monthly"
    },
    {
      "key": "retail",
      "fred": "RSAFS",
      "title": "Retail sales, y/y",
      "units": "%",
      "transform": "yoy",
      "fmt": "pct1",
      "chg": "pp",
      "freq": "Monthly"
    },
    {
      "key": "t5yie",
      "fred": "T5YIE",
      "title": "5Y breakeven inflation",
      "units": "%",
      "transform": "level",
      "fmt": "pct2",
      "chg": "bp",
      "freq": "Daily",
      "kpi": false,
      "src_label": "FRED T5YIE"
    },
    {
      "key": "t10yie",
      "fred": "T10YIE",
      "title": "10Y breakeven inflation",
      "units": "%",
      "transform": "level",
      "fmt": "pct2",
      "chg": "bp",
      "freq": "Daily",
      "kpi": false,
      "src_label": "FRED T10YIE"
    },
    {
      "key": "t5yifr",
