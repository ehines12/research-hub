  "sections": [
    {
      "title": "Growth",
      "panels": [
        {
          "title": "Real GDP growth (% q/q SAAR)",
          "type": "bar",
          "series": [
            "gdp"
          ]
        },
        {
          "title": "GDPNow nowcast vs. actual real GDP growth, by quarter (% q/q SAAR)",
          "type": "bar",
          "types": [
            "bar",
            "line"
          ],
          "series": [
            "gdp",
            "gdpnow_q"
          ],
          "labels": [
            "Actual (BEA)",
            "GDPNow (latest nowcast)"
          ],
          "wide": true
        },
        {
          "title": "Atlanta Fed GDPNow, daily nowcast history (% q/q SAAR)",
          "type": "line",
          "series": [
            "gdpnow"
          ],
          "zero": true
        },
        {
          "title": "Industrial production (% y/y)",
          "type": "line",
          "series": [
            "indpro"
          ],
          "zero": true
        },
        {
          "title": "Retail sales (% y/y)",
          "type": "line",
          "series": [
            "retail"
          ],
          "zero": true
        }
      ]
    },
    {
      "title": "Labor",
      "panels": [
        {
          "title": "Nonfarm payrolls, monthly change (thous.)",
          "type": "bar",
          "series": [
            "payrolls"
          ]
        },
        {
          "title": "Unemployment rate (%)",
          "type": "line",
          "series": [
            "unrate"
          ]
        },
        {
          "title": "Initial jobless claims (thous.)",
          "type": "line",
          "series": [
            "claims"
          ]
        }
      ]
    },
    {
      "title": "Inflation",
      "panels": [
        {
          "title": "CPI vs. core PCE (% y/y)",
          "type": "line",
          "series": [
            "cpi",
            "corepce"
          ],
          "ref": 2,
          "refLabel": "2% target",
          "wide": false
        },
        {
          "title": "Market inflation expectations: 5Y & 10Y breakevens, 5y5y forward (%)",
          "type": "line",
          "series": [
            "t5yie",
            "t10yie",
            "t5yifr"
          ],
          "ref": 2,
          "refLabel": "2%",
          "wide": true,
          "note": "Breakevens = nominal minus TIPS yield (CPI-based, includes risk/liquidity premia); the Fed's 2% target is for PCE."
        }
      ],
      "kpis": [
        "t5yie",
        "t10yie",
        "t5yifr"
      ]
    },
    {
      "title": "Cleveland Fed inflation nowcast",
      "link": "https://www.clevelandfed.org/indicators-and-data/inflation-nowcasting",
      "kpis": [
        "clev_cpi_yy",
        "clev_ccpi_yy",
        "clev_pce_yy",
        "clev_cpce_yy"
      ],
      "nowcast_table": {
        "measures": [
          {
            "label": "CPI",
            "yy": "clev_cpi_yy",
            "q": "clev_cpi_q"
          },
          {
            "label": "Core CPI",
            "yy": "clev_ccpi_yy",
            "q": "clev_ccpi_q"
          },
          {
            "label": "PCE",
            "yy": "clev_pce_yy",
            "q": "clev_pce_q"
          },
          {
            "label": "Core PCE",
            "yy": "clev_cpce_yy",
            "q": "clev_cpce_q"
          }
        ],
        "note": "Months: y/y with m/m below. Quarters: q/q annualized. Only targets still being nowcast are shown; as-of = latest update."
      },
      "panels": [
        {
          "title": "CPI y/y: Cleveland Fed nowcast vs. actual, by month (%)",
          "type": "line",
          "series": [
            "clev_cpi_yy",
            "clev_cpi_yy_act"
          ],
          "labels": [
            "Nowcast (latest; final pre-release for past months)",
            "Actual"
          ],
          "ref": 2,
          "refLabel": "2%"
        },
        {
          "title": "Core PCE y/y: Cleveland Fed nowcast vs. actual, by month (%)",
          "type": "line",
          "series": [
            "clev_cpce_yy",
            "clev_cpce_yy_act"
          ],
          "labels": [
            "Nowcast (latest; final pre-release for past months)",
            "Actual"
          ],
          "ref": 2,
          "refLabel": "2% target"
        }
      ]
    },
    {
      "title": "Policy & Rates",
      "panels": [
        {
          "title": "Fed funds, 2Y and 10Y Treasury (%)",
          "type": "line",
          "series": [
            "dff",
            "dgs2",
            "dgs10"
          ],
          "wide": true
        },
        {
          "title": "10Y - 2Y Treasury spread (pp)",
          "type": "line",
          "series": [
            "spread"
          ],
          "zero": true,
          "fill": true
        }
      ]
    },
    {
      "title": "Real-time & Alt Data",
      "kpis": [
        "indeed",
        "dts_20d",
        "gas",
        "wti",
        "wei",
        "ccsa",
        "nfci",
        "stlfsi"
      ],
      "panels": [
        {
          "title": "Indeed job postings index (Feb 1, 2020 = 100)",
          "type": "line",
          "series": [
            "indeed"
          ],
          "ref": 100,
          "refLabel": "Feb 2020"
        },
        {
          "title": "Withheld income & payroll tax receipts, rolling business-day sums, y/y (%)",
          "type": "line",
          "series": [
            "dts_yoy",
            "dts_yoy60"
          ],
          "zero": true,
          "note": "Daily Treasury Statement deposits, 'Taxes - Withheld Individual/FICA'. Calendar/payday timing makes this noisy around month-ends and holidays.",
          "labels": [
            "20-business-day sum, y/y",
            "60-business-day sum, y/y"
          ],
          "wide": true
        },
        {
          "title": "Retail gasoline ($/gal, left) and WTI crude ($/bbl, right)",
          "type": "line",
          "series": [
            "gas",
            "wti"
          ],
          "y2": [
            "wti"
          ],
          "labels": [
            "Gasoline, regular ($/gal)",
            "WTI ($/bbl)"
          ]
        },
        {
          "title": "NY Fed Weekly Economic Index (scaled to 4Q GDP growth, %)",
          "type": "line",
          "series": [
            "wei"
          ],
          "zero": true
        },
        {
          "title": "Continuing jobless claims (thous.)",
          "type": "line",
          "series": [
            "ccsa"
          ]
        },
        {
          "title": "Financial conditions: Chicago Fed NFCI and St. Louis Fed Financial Stress Index (0 = average/normal; negative = looser)",
          "type": "line",
          "series": [
            "nfci",
            "stlfsi"
          ],
          "zero": true,
          "labels": [
            "Chicago Fed NFCI",
            "St. Louis Fed Financial Stress Index"
          ],
          "full": true
        }
      ]
    }
  ]
