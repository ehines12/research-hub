      "title": "CPI nowcast, y/y",
      "units": "% y/y",
      "transform": "level",
      "fmt": "pct2",
      "chg": "bp",
      "freq": "Monthly",
      "no_yoy": true,
      "kpi": false,
      "invert": true,
      "link": "https://www.clevelandfed.org/indicators-and-data/inflation-nowcasting",
